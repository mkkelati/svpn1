#!/bin/bash
# VLESS Reality - Live Connection Monitor for DRAGON VPS MANAGER
# Shows live count of users connected via VLESS Reality protocol

VLESS_DIR="/etc/vless-reality"
VLESS_USERS="$VLESS_DIR/users"

[[ ! -f /usr/local/bin/xray ]] && {
    echo -e "\033[1;31m◇ VLESS Reality is not installed! Use option [31] first.\033[0m"
    exit 1
}

# Get VLESS port
VLESS_PORT=$(cat "$VLESS_DIR/port" 2>/dev/null || echo "443")

# Function to get unique connected IPs on VLESS port
get_active_connections() {
    ss -tn state established "( dport = :$VLESS_PORT or sport = :$VLESS_PORT )" 2>/dev/null | \
        awk 'NR>1 {print $4}' | \
        awk -F: '{NF--; print}' OFS=: | \
        sort -u | wc -l
}

# Function to get total established TCP connections on VLESS port
get_total_connections() {
    ss -tn state established "( sport = :$VLESS_PORT )" 2>/dev/null | tail -n +2 | wc -l
}

# Function to query xray stats API for active users (with traffic in last interval)
get_user_stats() {
    local user="$1"
    local type="$2"  # uplink or downlink
    /usr/local/bin/xray api statsquery --server=127.0.0.1:10085 -pattern "user>>>${user}>>>traffic>>>${type}" 2>/dev/null | \
        grep -oP '"value":\s*"\K[0-9]+' | head -1
}

format_bytes() {
    local bytes=$1
    [[ -z "$bytes" || "$bytes" == "0" ]] && { echo "0 B"; return; }
    if (( bytes < 1024 )); then echo "${bytes} B"
    elif (( bytes < 1048576 )); then echo "$(awk "BEGIN{printf \"%.2f KB\", $bytes/1024}")"
    elif (( bytes < 1073741824 )); then echo "$(awk "BEGIN{printf \"%.2f MB\", $bytes/1048576}")"
    else echo "$(awk "BEGIN{printf \"%.2f GB\", $bytes/1073741824}")"
    fi
}

# Track previous traffic for live "active" detection
declare -A prev_up prev_down

trap "tput cnorm; clear; exit 0" SIGINT SIGTERM

tput civis  # hide cursor

while true; do
    clear
    tput setaf 7 ; tput setab 4 ; tput bold
    printf '%40s%s%-12s\n' "◇──ㅤ🐉ㅤVLESS REALITY LIVE MONITORㅤ🐉ㅤ──◇"
    tput sgr0
    echo ""

    if ! systemctl is-active --quiet xray; then
        echo -e "\033[1;31m◇ XRay service is NOT running!\033[0m"
        echo ""
        echo -e "\033[1;33m◇ Press CTRL+C to exit\033[0m"
        sleep 3
        continue
    fi

    total_users=$(ls "$VLESS_USERS" 2>/dev/null | wc -l)
    unique_ips=$(get_active_connections)
    total_conn=$(get_total_connections)

    echo -e "\033[0;34m◇───────────────────────────────────────────────────◇\033[0m"
    echo -e "\033[1;32m◇ Server Time:        \033[1;37m$(date '+%Y-%m-%d %H:%M:%S')\033[0m"
    echo -e "\033[1;32m◇ VLESS Port:         \033[1;37m$VLESS_PORT\033[0m"
    echo -e "\033[1;32m◇ XRay Status:        \033[1;32m♦ RUNNING\033[0m"
    echo -e "\033[0;34m◇───────────────────────────────────────────────────◇\033[0m"
    echo -e "\033[1;33m◇ Total Registered Users:    \033[1;37m$total_users\033[0m"
    echo -e "\033[1;33m◇ Unique Connected IPs:      \033[1;32m$unique_ips\033[0m"
    echo -e "\033[1;33m◇ Total Live Connections:    \033[1;36m$total_conn\033[0m"
    echo -e "\033[0;34m◇───────────────────────────────────────────────────◇\033[0m"
    echo ""
    echo -e "\033[1;36m◇ PER-USER LIVE STATUS:\033[0m"
    echo ""
    printf "\033[1;33m%-18s %-10s %-15s %-15s\n" "USER" "STATUS" "UPLOAD" "DOWNLOAD"
    echo -e "\033[0;34m───────────────────────────────────────────────────────\033[0m"

    active_count=0

    if [[ "$total_users" -gt 0 ]]; then
        for user_file in "$VLESS_USERS"/*; do
            [[ ! -f "$user_file" ]] && continue
            uname=$(basename "$user_file")

            up=$(get_user_stats "$uname" "uplink")
            down=$(get_user_stats "$uname" "downlink")
            up=${up:-0}
            down=${down:-0}

            # Detect ACTIVE = traffic increased since last refresh
            p_up=${prev_up[$uname]:-0}
            p_down=${prev_down[$uname]:-0}

            if (( up > p_up || down > p_down )); then
                status="\033[1;32m♦ ONLINE\033[0m"
                active_count=$((active_count + 1))
            else
                status="\033[1;31m○ OFFLINE\033[0m"
            fi

            prev_up[$uname]=$up
            prev_down[$uname]=$down

            printf "\033[1;37m%-18s %-19b %-15s %-15s\n" "$uname" "$status" "$(format_bytes $up)" "$(format_bytes $down)"
        done
    else
        echo -e "\033[1;31m◇ No VLESS users created yet. Use option [32] to add.\033[0m"
    fi

    echo ""
    echo -e "\033[0;34m◇───────────────────────────────────────────────────◇\033[0m"
    echo -e "\033[1;32m◇ ACTIVE USERS NOW: \033[1;33m$active_count\033[1;32m / $total_users\033[0m"
    echo -e "\033[0;34m◇───────────────────────────────────────────────────◇\033[0m"
    echo ""
    echo -e "\033[1;33m◇ Refreshing every 3 seconds... Press \033[1;31mCTRL+C\033[1;33m to exit.\033[0m"

    sleep 3
done
