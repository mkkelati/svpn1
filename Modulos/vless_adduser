#!/bin/bash
# VLESS Reality - Add User Module for DRAGON VPS MANAGER

VLESS_DIR="/etc/vless-reality"
VLESS_USERS="$VLESS_DIR/users"
VLESS_CONFIG="/usr/local/etc/xray/config.json"

[[ ! -f /usr/local/bin/xray ]] && {
    echo -e "\033[1;31m◇ VLESS Reality is not installed! Use option [31] first.\033[0m"
    exit 1
}

clear
tput setaf 7 ; tput setab 4 ; tput bold ; printf '%40s%s%-12s\n' "◇───ㅤ🐉ㅤADD VLESS USERㅤ🐉ㅤ───◇" ; tput sgr0
echo ""

# Get username
echo -ne "\033[1;36m◇ Enter username: \033[1;37m"; read username

# Validate username
[[ -z "$username" ]] && {
    echo -e "\033[1;31m◇ Username cannot be empty!\033[0m"
    exit 1
}

# Check if user already exists
[[ -f "$VLESS_USERS/$username" ]] && {
    echo -e "\033[1;31m◇ User '$username' already exists!\033[0m"
    exit 1
}

# Get expiry days
echo ""
echo -ne "\033[1;36m◇ Enter number of days until expiry: \033[1;37m"; read days

# Validate days
[[ -z "$days" ]] && days=30
[[ ! "$days" =~ ^[0-9]+$ ]] && {
    echo -e "\033[1;31m◇ Invalid number of days!\033[0m"
    exit 1
}

# Calculate expiry date
expiry_date=$(date -d "+${days} days" +%Y-%m-%d)

# Generate UUID for this user
USER_UUID=$(/usr/local/bin/xray uuid)

echo ""
echo -e "\033[1;32m◇ Creating VLESS user...\033[0m"

# Save user info
cat > "$VLESS_USERS/$username" << EOF
UUID=$USER_UUID
CREATED=$(date +%Y-%m-%d)
EXPIRY=$expiry_date
DAYS=$days
USERNAME=$username
EOF

# Add user to XRay config using jq or python
# Read current clients and add new one
if command -v jq &> /dev/null; then
    # Use jq to add client
    jq ".inbounds[0].settings.clients += [{\"id\": \"$USER_UUID\", \"flow\": \"xtls-rprx-vision\"}]" "$VLESS_CONFIG" > /tmp/xray_tmp.json
    mv /tmp/xray_tmp.json "$VLESS_CONFIG"
else
    # Use python3 as fallback
    python3 -c "
import json
with open('$VLESS_CONFIG', 'r') as f:
    config = json.load(f)
config['inbounds'][0]['settings']['clients'].append({
    'id': '$USER_UUID',
    'flow': 'xtls-rprx-vision'
})
with open('$VLESS_CONFIG', 'w') as f:
    json.dump(config, f, indent=2)
"
fi

# Restart XRay to apply
systemctl restart xray > /dev/null 2>&1

sleep 1

# Setup expiry cron job for this user
CRON_CMD="0 0 * * * root /bin/bash /usr/local/bin/vless_expire_check"
(crontab -l 2>/dev/null | grep -q "vless_expire_check") || {
    (crontab -l 2>/dev/null; echo "$CRON_CMD") | crontab -
}

# Read server info
SERVER_IP=$(cat "$VLESS_DIR/server_ip" 2>/dev/null || wget -qO- ipv4.icanhazip.com)
PORT=$(cat "$VLESS_DIR/port" 2>/dev/null || echo "443")
PUBLIC_KEY=$(cat "$VLESS_DIR/public.key")
SHORT_ID=$(cat "$VLESS_DIR/short_id")
SNI=$(cat "$VLESS_DIR/sni")

# Generate VLESS link
VLESS_LINK="vless://${USER_UUID}@${SERVER_IP}:${PORT}?encryption=none&flow=xtls-rprx-vision&security=reality&sni=${SNI}&fp=chrome&pbk=${PUBLIC_KEY}&sid=${SHORT_ID}&type=tcp&headerType=none#DRAGON-${username}"

# Save link to user file
echo "LINK=$VLESS_LINK" >> "$VLESS_USERS/$username"

if systemctl is-active --quiet xray; then
    echo ""
    echo -e "\033[0;34m◇───────────────────────────────────────────────────◇\033[0m"
    echo -e "\033[1;32m◇ VLESS USER CREATED SUCCESSFULLY!\033[0m"
    echo -e "\033[0;34m◇───────────────────────────────────────────────────◇\033[0m"
    echo ""
    echo -e "\033[1;33m◇ Username:    \033[1;37m$username\033[0m"
    echo -e "\033[1;33m◇ UUID:        \033[1;37m$USER_UUID\033[0m"
    echo -e "\033[1;33m◇ Created:     \033[1;37m$(date +%Y-%m-%d)\033[0m"
    echo -e "\033[1;33m◇ Expires:     \033[1;37m$expiry_date ($days days)\033[0m"
    echo -e "\033[1;33m◇ Server:      \033[1;37m$SERVER_IP:$PORT\033[0m"
    echo -e "\033[1;33m◇ SNI:         \033[1;37m$SNI\033[0m"
    echo ""
    echo -e "\033[1;36m◇ CONNECTION LINK (copy this to v2rayNG app):\033[0m"
    echo -e "\033[1;37m$VLESS_LINK\033[0m"
    echo ""
    echo -e "\033[0;34m◇───────────────────────────────────────────────────◇\033[0m"
    echo -e "\033[1;33m◇ Use option [34] to export link anytime.\033[0m"
    echo -e "\033[0;34m◇───────────────────────────────────────────────────◇\033[0m"
else
    echo -e "\033[1;31m◇ WARNING: XRay is not running! Check: journalctl -u xray\033[0m"
fi
