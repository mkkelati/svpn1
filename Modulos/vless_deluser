#!/bin/bash
# VLESS Reality - Remove User Module for DRAGON VPS MANAGER

VLESS_DIR="/etc/vless-reality"
VLESS_USERS="$VLESS_DIR/users"
VLESS_CONFIG="/usr/local/etc/xray/config.json"

[[ ! -f /usr/local/bin/xray ]] && {
    echo -e "\033[1;31m◇ VLESS Reality is not installed! Use option [31] first.\033[0m"
    exit 1
}

clear
tput setaf 7 ; tput setab 4 ; tput bold ; printf '%40s%s%-12s\n' "◇───ㅤ🐉ㅤREMOVE VLESS USERㅤ🐉ㅤ───◇" ; tput sgr0
echo ""

# List users
user_count=$(ls "$VLESS_USERS" 2>/dev/null | wc -l)

if [[ "$user_count" -eq 0 ]]; then
    echo -e "\033[1;31m◇ No VLESS users found!\033[0m"
    exit 1
fi

echo -e "\033[1;33m◇ VLESS USERS LIST:\033[0m"
echo ""

i=0
declare -a user_list
for user_file in "$VLESS_USERS"/*; do
    [[ ! -f "$user_file" ]] && continue
    i=$((i + 1))
    uname=$(basename "$user_file")
    expiry=$(grep "EXPIRY=" "$user_file" | cut -d= -f2)
    uuid=$(grep "UUID=" "$user_file" | cut -d= -f2)

    # Check if expired
    today=$(date +%s)
    exp_ts=$(date -d "$expiry" +%s 2>/dev/null || echo "0")
    if [[ "$today" -gt "$exp_ts" ]]; then
        status="\033[1;31m[EXPIRED]\033[0m"
    else
        status="\033[1;32m[ACTIVE]\033[0m"
    fi

    printf "\033[1;31m[\033[1;36m%02d\033[1;31m] \033[1;37m%-15s \033[1;33mExpires: %-12s %b\n" "$i" "$uname" "$expiry" "$status"
    user_list[$i]="$uname"
done

echo ""
echo -e "\033[1;31m[\033[1;36m 0\033[1;31m] \033[1;33mCANCEL\033[0m"
echo ""
echo -ne "\033[1;32m◇ Select user to remove [0-$i]: \033[1;37m"; read choice

[[ "$choice" == "0" || -z "$choice" ]] && exit 0

selected="${user_list[$choice]}"
[[ -z "$selected" ]] && {
    echo -e "\033[1;31m◇ Invalid selection!\033[0m"
    exit 1
}

echo ""
echo -ne "\033[1;36m◇ Remove user '$selected'? [Y/N]: \033[1;37m"; read confirm
[[ "$confirm" = @(n|N) ]] && exit 0

# Get UUID of user to remove
USER_UUID=$(grep "UUID=" "$VLESS_USERS/$selected" | cut -d= -f2)

# Remove from XRay config
if command -v jq &> /dev/null; then
    jq "del(.inbounds[0].settings.clients[] | select(.id == \"$USER_UUID\"))" "$VLESS_CONFIG" > /tmp/xray_tmp.json
    mv /tmp/xray_tmp.json "$VLESS_CONFIG"
else
    python3 -c "
import json
with open('$VLESS_CONFIG', 'r') as f:
    config = json.load(f)
config['inbounds'][0]['settings']['clients'] = [
    c for c in config['inbounds'][0]['settings']['clients']
    if c['id'] != '$USER_UUID'
]
with open('$VLESS_CONFIG', 'w') as f:
    json.dump(config, f, indent=2)
"
fi

# Remove user file
rm -f "$VLESS_USERS/$selected"

# Restart XRay
systemctl restart xray > /dev/null 2>&1

echo ""
echo -e "\033[0;34m◇───────────────────────────────────────────────────◇\033[0m"
echo -e "\E[41;1;37m◇ User '$selected' successfully removed! \E[0m"
echo -e "\033[0;34m◇───────────────────────────────────────────────────◇\033[0m"
