#!/bin/bash
# VLESS + Reality Installation Module for DRAGON VPS MANAGER
# AES256-GCM & ChaCha20-Poly1305 with Obfuscation

VLESS_DIR="/etc/vless-reality"
VLESS_CONFIG="/usr/local/etc/xray/config.json"
VLESS_USERS="$VLESS_DIR/users"

clear
tput setaf 7 ; tput setab 4 ; tput bold ; printf '%40s%s%-12s\n' "◇───ㅤ🐉ㅤVLESS REALITY INSTALLERㅤ🐉ㅤ───◇" ; tput sgr0
echo ""

# Check if already installed
if [[ -f /usr/local/bin/xray ]]; then
    echo -e "\033[1;32m◇ VLESS Reality is already installed!\033[0m"
    echo -e "\033[1;33m◇ XRay version: \033[1;37m$(/usr/local/bin/xray version | head -1)\033[0m"
    echo ""
    echo -ne "\033[1;36m◇ Reinstall? [Y/N]: \033[1;37m"; read reinstall
    [[ "$reinstall" = @(n|N) ]] && exit 0
fi

echo -e "\033[1;33m◇ This will install XRay with VLESS + Reality protocol.\033[0m"
echo -e "\033[1;33m◇ Uses AES256-GCM & ChaCha20-Poly1305 ciphers.\033[0m"
echo -e "\033[1;33m◇ Traffic looks like normal HTTPS - ISPs cannot detect it.\033[0m"
echo ""
echo -ne "\033[1;36m◇ Continue installation? [Y/N]: \033[1;37m"; read confirm
[[ "$confirm" = @(n|N) ]] && exit 0

echo ""
echo -e "\033[1;32m◇ STEP 1: Installing XRay...\033[0m"
echo ""

# Install XRay
bash -c "$(curl -L https://github.com/XTLS/Xray-install/raw/main/install-release.sh)" @ install > /dev/null 2>&1

if [[ ! -f /usr/local/bin/xray ]]; then
    echo -e "\033[1;31m◇ ERROR: XRay installation failed!\033[0m"
    echo -e "\033[1;33m◇ Check your internet connection and try again.\033[0m"
    exit 1
fi

echo -e "\033[1;32m◇ XRay installed successfully!\033[0m"
echo ""

# Create directories
mkdir -p "$VLESS_DIR" "$VLESS_USERS" /usr/local/etc/xray

# Generate keys
echo -e "\033[1;32m◇ STEP 2: Generating security keys...\033[0m"

KEYS=$(/usr/local/bin/xray x25519)
PRIVATE_KEY=$(echo "$KEYS" | grep "Private" | awk '{print $NF}')
PUBLIC_KEY=$(echo "$KEYS" | grep "Public" | awk '{print $NF}')
SHORT_ID=$(openssl rand -hex 8)

# Save server keys
echo "$PRIVATE_KEY" > "$VLESS_DIR/private.key"
echo "$PUBLIC_KEY" > "$VLESS_DIR/public.key"
echo "$SHORT_ID" > "$VLESS_DIR/short_id"

echo -e "\033[1;32m◇ Keys generated!\033[0m"
echo ""

# Ask for port
echo -ne "\033[1;36m◇ Enter port for VLESS (default 443): \033[1;37m"; read vless_port
[[ -z "$vless_port" ]] && vless_port=443

# Ask for SNI (destination site to mimic)
echo ""
echo -e "\033[1;33m◇ Choose a website to disguise traffic as:\033[0m"
echo -e "\033[1;31m[\033[1;36m1\033[1;31m]\033[1;37m www.microsoft.com (recommended)"
echo -e "\033[1;31m[\033[1;36m2\033[1;31m]\033[1;37m www.apple.com"
echo -e "\033[1;31m[\033[1;36m3\033[1;31m]\033[1;37m www.amazon.com"
echo -e "\033[1;31m[\033[1;36m4\033[1;31m]\033[1;37m www.google.com"
echo -e "\033[1;31m[\033[1;36m5\033[1;31m]\033[1;37m Custom domain"
echo ""
echo -ne "\033[1;36m◇ Select [1-5]: \033[1;37m"; read sni_choice

case "$sni_choice" in
    1) SNI="www.microsoft.com" ;;
    2) SNI="www.apple.com" ;;
    3) SNI="www.amazon.com" ;;
    4) SNI="www.google.com" ;;
    5) echo -ne "\033[1;36m◇ Enter domain: \033[1;37m"; read SNI ;;
    *) SNI="www.microsoft.com" ;;
esac

echo "$SNI" > "$VLESS_DIR/sni"
echo "$vless_port" > "$VLESS_DIR/port"

# Get server IP
IP=$(wget -qO- ipv4.icanhazip.com 2>/dev/null || curl -s ipv4.icanhazip.com)
echo "$IP" > "$VLESS_DIR/server_ip"

echo ""
echo -e "\033[1;32m◇ STEP 3: Creating XRay configuration...\033[0m"

# Create config (no users yet - they are added via vless_adduser)
cat > "$VLESS_CONFIG" << EOF
{
  "log": {
    "loglevel": "warning"
  },
  "inbounds": [
    {
      "listen": "0.0.0.0",
      "port": $vless_port,
      "protocol": "vless",
      "settings": {
        "clients": [],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "tcp",
        "security": "reality",
        "realitySettings": {
          "show": false,
          "dest": "$SNI:443",
          "xver": 0,
          "serverNames": [
            "$SNI"
          ],
          "privateKey": "$PRIVATE_KEY",
          "shortIds": [
            "$SHORT_ID"
          ]
        }
      }
    }
  ],
  "outbounds": [
    {
      "protocol": "freedom",
      "tag": "direct"
    }
  ]
}
EOF

echo -e "\033[1;32m◇ Configuration created!\033[0m"
echo ""

# Open firewall
echo -e "\033[1;32m◇ STEP 4: Configuring firewall...\033[0m"
[[ -f "/usr/sbin/ufw" ]] && ufw allow $vless_port/tcp > /dev/null 2>&1
echo -e "\033[1;32m◇ Firewall configured!\033[0m"
echo ""

# Enable and start
echo -e "\033[1;32m◇ STEP 5: Starting XRay service...\033[0m"
systemctl enable xray > /dev/null 2>&1
systemctl restart xray > /dev/null 2>&1

sleep 2

if systemctl is-active --quiet xray; then
    echo -e "\033[1;32m◇ XRay is running!\033[0m"
else
    echo -e "\033[1;31m◇ ERROR: XRay failed to start. Check logs:\033[0m"
    echo -e "\033[1;33m  journalctl -u xray -n 20\033[0m"
    exit 1
fi

echo ""
echo -e "\033[0;34m◇───────────────────────────────────────────────────◇\033[0m"
echo -e "\033[1;32m◇ VLESS REALITY INSTALLED SUCCESSFULLY!\033[0m"
echo -e "\033[0;34m◇───────────────────────────────────────────────────◇\033[0m"
echo ""
echo -e "\033[1;33m◇ Server IP:      \033[1;37m$IP\033[0m"
echo -e "\033[1;33m◇ Port:           \033[1;37m$vless_port\033[0m"
echo -e "\033[1;33m◇ Protocol:       \033[1;37mVLESS + Reality\033[0m"
echo -e "\033[1;33m◇ Ciphers:        \033[1;37mAES256-GCM / ChaCha20-Poly1305\033[0m"
echo -e "\033[1;33m◇ SNI:            \033[1;37m$SNI\033[0m"
echo -e "\033[1;33m◇ Public Key:     \033[1;37m$PUBLIC_KEY\033[0m"
echo ""
echo -e "\033[1;36m◇ Now use option [32] to ADD VLESS USERS\033[0m"
echo -e "\033[1;36m◇ Use option [34] to EXPORT connection links\033[0m"
echo -e "\033[0;34m◇───────────────────────────────────────────────────◇\033[0m"
