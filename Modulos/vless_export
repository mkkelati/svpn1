#!/bin/bash
# VLESS Reality - Export Link Module for DRAGON VPS MANAGER

VLESS_DIR="/etc/vless-reality"
VLESS_USERS="$VLESS_DIR/users"

[[ ! -f /usr/local/bin/xray ]] && {
    echo -e "\033[1;31m◇ VLESS Reality is not installed! Use option [31] first.\033[0m"
    exit 1
}

clear
tput setaf 7 ; tput setab 4 ; tput bold ; printf '%40s%s%-12s\n' "◇───ㅤ🐉ㅤEXPORT VLESS LINKSㅤ🐉ㅤ───◇" ; tput sgr0
echo ""

# List users
user_count=$(ls "$VLESS_USERS" 2>/dev/null | wc -l)

if [[ "$user_count" -eq 0 ]]; then
    echo -e "\033[1;31m◇ No VLESS users found! Create one with option [32].\033[0m"
    exit 1
fi

echo -e "\033[1;33m◇ VLESS USERS:\033[0m"
echo ""

i=0
declare -a user_list
for user_file in "$VLESS_USERS"/*; do
    [[ ! -f "$user_file" ]] && continue
    i=$((i + 1))
    uname=$(basename "$user_file")
    expiry=$(grep "EXPIRY=" "$user_file" | cut -d= -f2)

    # Check if expired
    today=$(date +%s)
    exp_ts=$(date -d "$expiry" +%s 2>/dev/null || echo "0")
    if [[ "$today" -gt "$exp_ts" ]]; then
        status="\033[1;31m[EXPIRED]\033[0m"
    else
        status="\033[1;32m[ACTIVE]\033[0m"
    fi

    printf "\033[1;31m[\033[1;36m%02d\033[1;31m] \033[1;37m%-15s \033[1;33mExpires: %-12s %b\n" "$i" "$uname" "$expiry" "$status"
    user_list[$i]="$uname"
done

echo ""
echo -e "\033[1;31m[\033[1;36m 0\033[1;31m] \033[1;33mEXPORT ALL LINKS\033[0m"
echo -e "\033[1;31m[\033[1;36m99\033[1;31m] \033[1;33mCANCEL\033[0m"
echo ""
echo -ne "\033[1;32m◇ Select user [0=ALL, 99=CANCEL]: \033[1;37m"; read choice

[[ "$choice" == "99" ]] && exit 0

echo ""
echo -e "\033[0;34m◇───────────────────────────────────────────────────◇\033[0m"

if [[ "$choice" == "0" ]]; then
    # Export all users
    for user_file in "$VLESS_USERS"/*; do
        [[ ! -f "$user_file" ]] && continue
        uname=$(basename "$user_file")
        link=$(grep "LINK=" "$user_file" | cut -d= -f2-)
        expiry=$(grep "EXPIRY=" "$user_file" | cut -d= -f2)
        uuid=$(grep "UUID=" "$user_file" | cut -d= -f2)

        today=$(date +%s)
        exp_ts=$(date -d "$expiry" +%s 2>/dev/null || echo "0")
        if [[ "$today" -gt "$exp_ts" ]]; then
            status="\033[1;31m[EXPIRED]\033[0m"
        else
            status="\033[1;32m[ACTIVE]\033[0m"
        fi

        echo ""
        echo -e "\033[1;36m◇ User: \033[1;37m$uname  $status"
        echo -e "\033[1;33m◇ Expires: \033[1;37m$expiry\033[0m"
        echo -e "\033[1;33m◇ UUID: \033[1;37m$uuid\033[0m"
        echo -e "\033[1;32m◇ Link:\033[0m"
        echo -e "\033[1;37m$link\033[0m"
        echo -e "\033[0;34m◇───────────────────────────────────────────────────◇\033[0m"
    done
else
    # Export single user
    selected="${user_list[$choice]}"
    [[ -z "$selected" ]] && {
        echo -e "\033[1;31m◇ Invalid selection!\033[0m"
        exit 1
    }

    link=$(grep "LINK=" "$VLESS_USERS/$selected" | cut -d= -f2-)
    expiry=$(grep "EXPIRY=" "$VLESS_USERS/$selected" | cut -d= -f2)
    uuid=$(grep "UUID=" "$VLESS_USERS/$selected" | cut -d= -f2)
    created=$(grep "CREATED=" "$VLESS_USERS/$selected" | cut -d= -f2)

    today=$(date +%s)
    exp_ts=$(date -d "$expiry" +%s 2>/dev/null || echo "0")
    if [[ "$today" -gt "$exp_ts" ]]; then
        status="\033[1;31m[EXPIRED]\033[0m"
    else
        remaining=$(( (exp_ts - today) / 86400 ))
        status="\033[1;32m[ACTIVE - $remaining days left]\033[0m"
    fi

    SERVER_IP=$(cat "$VLESS_DIR/server_ip" 2>/dev/null)
    PORT=$(cat "$VLESS_DIR/port" 2>/dev/null)
    SNI=$(cat "$VLESS_DIR/sni" 2>/dev/null)
    PUBLIC_KEY=$(cat "$VLESS_DIR/public.key" 2>/dev/null)

    echo ""
    echo -e "\033[1;36m◇ User:       \033[1;37m$selected  $status\033[0m"
    echo -e "\033[1;33m◇ UUID:       \033[1;37m$uuid\033[0m"
    echo -e "\033[1;33m◇ Created:    \033[1;37m$created\033[0m"
    echo -e "\033[1;33m◇ Expires:    \033[1;37m$expiry\033[0m"
    echo -e "\033[1;33m◇ Server:     \033[1;37m$SERVER_IP:$PORT\033[0m"
    echo -e "\033[1;33m◇ SNI:        \033[1;37m$SNI\033[0m"
    echo -e "\033[1;33m◇ Public Key: \033[1;37m$PUBLIC_KEY\033[0m"
    echo ""
    echo -e "\033[1;32m◇ CONNECTION LINK (copy to v2rayNG / NekoBox):\033[0m"
    echo ""
    echo -e "\033[1;37m$link\033[0m"
    echo ""
    echo -e "\033[0;34m◇───────────────────────────────────────────────────◇\033[0m"
fi

echo ""
echo -e "\033[1;33m◇ Import this link in: v2rayNG (Android), Streisand (iOS), v2rayN (Windows)\033[0m"
echo -e "\033[0;34m◇───────────────────────────────────────────────────◇\033[0m"
